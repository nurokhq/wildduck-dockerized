# Where your server can be reached from the outside for IMAP,SMTP,Webmail. Can be multiple seperated by a comma
HOSTNAMES=example.com

# Used as the let's encrypt contact address for expiry notices: https://letsencrypt.org/docs/expiration-emails/
# ACME_EMAIL=john@example.com

# WildDuck API access token (optional - if not set, a random token will be generated)
# ACCESS_TOKEN=your_secret_access_token_here

# Next MTA configuration (optional - if set, messages will be sent to this MTA instead of actual MX)
# NEXTMTA_HOST=smtp.ethereal.email
# NEXTMTA_PORT=587
# NEXTMTA_USER=gsblpjxjdvhnqkgr@ethereal.email
# NEXTMTA_PASS=zDZpDnSsFf11Zfvtv5